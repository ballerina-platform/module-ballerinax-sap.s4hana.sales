    # Tax Classification for Material
    string? ProductTaxClassification5?;
    # Tax Classification for Material
    string? ProductTaxClassification6?;
    # Tax Classification for Material
    string? ProductTaxClassification7?;
    # Tax Classification for Material
    string? ProductTaxClassification8?;
    # Tax Classification for Material
    string? ProductTaxClassification9?;
