    # Overall Status of Credit Checks
    string? TotalCreditCheckStatus?;
    # Rejection Status (All Items)
    string? OverallSDDocumentRejectionSts?;
    A_CustomerReturnOverviewStatus? to_CustomerReturnOverviewStatus?;
    A_CustomerReturn_to_Item to_Item?;
    A_CustomerReturn_to_Partner to_Partner?;
