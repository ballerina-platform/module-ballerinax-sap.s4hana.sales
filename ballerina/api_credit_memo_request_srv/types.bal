    string? RelatedProcFlowDocStsFieldName?;
    # Record Creation Date
    string? CreationDate?;
    # Entry time
    string? CreationTime?;
    # Last Changed On
    string? LastChangeDate?;
    A_CreditMemoRequest to_CreditMemoRequest?;
};

