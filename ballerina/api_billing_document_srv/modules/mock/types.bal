    # Tax Classification 9 for Customer
    string? CustomerTaxClassification9?;
    # Indicator: Triangular Deal Within the EU
    boolean? IsEUTriangularDeal?;
    # Pricing Procedure in Pricing
    string? SDPricingProcedure?;
    string? ShippingCondition?;
    string? IncotermsVersion?;
    # Incoterms (Part 1)
    string? IncotermsClassification?;
    string? IncotermsTransferLocation?;
    string? IncotermsLocation1?;
    string? IncotermsLocation2?;
    string? PayerParty?;
    # Contract Account Number
    string? ContractAccount?;
    # Key for Terms of Payment
    string? CustomerPaymentTerms?;
    string? PaymentMethod?;
    string? PaymentReference?;
    string? FixedValueDate?;
    # Additional Value Days
    string? AdditionalValueDays?;
    # Unique Reference to Mandate for each Payee
    string? SEPAMandate?;
    string? CompanyCode?;
    string? FiscalYear?;
    # Document Number of an Accounting Document
    string? AccountingDocument?;
    # Account Assignment Group for Customer
    string? CustomerAccountAssignmentGroup?;
    # Indicator for Fixed Exchange Rate
    boolean? AccountingExchangeRateIsSet?;
    # Absolute exchange rate for FI postings
    string? AbsltAccountingExchangeRate?;
    # Accounting exchange rate quotation is indirect
    boolean? AcctgExchangeRateIsIndrctQtan?;
    string? ExchangeRateDate?;
    string? ExchangeRateType?;
    # Reference Document Number
    string? DocumentReferenceID?;
    # Assignment Number
    string? AssignmentReference?;
    string? DunningArea?;
    string? DunningBlockingReason?;
    string? DunningKey?;
    # Financial doc. processing: Internal financial doc. number
    string? InternalFinancialDocument?;
    # Is relevant for accrual
    boolean? IsRelevantForAccrual?;
    string? SoldToParty?;
    # Company ID of Trading Partner
    string? PartnerCompany?;
    string? PurchaseOrderByCustomer?;
    string? CustomerGroup?;
    # Destination Country/Region
    string? Country?;
    string? CityCode?;
    string? SalesDistrict?;
    # Region (State, Province, County)
    string? Region?;
    string? County?;
    string? CreditControlArea?;
    # Agreement (various conditions grouped together)
    string? CustomerRebateAgreement?;
    # Number of the Document Condition
    string? SalesDocumentCondition?;
    # Overall Processing Status (Header/All Items)
    string? OverallSDProcessStatus?;
    # SD Billing Status
    string? OverallBillingStatus?;
    # Posting Status of Billing Document
    string? AccountingPostingStatus?;
    # Status for Transfer to Accounting
    string? AccountingTransferStatus?;
    # Billing Issue Type
    string? BillingIssueType?;
    # Invoice list status of billing document
    string? InvoiceListStatus?;
    # Incompletion Status (All Items)
    string? OvrlItmGeneralIncompletionSts?;
    # Pricing Incompletion Status (All Items)
    string? OverallPricingIncompletionSts?;
    # Clearing Status of Billing Document
    string? InvoiceClearingStatus?;
    string? BillingDocumentListType?;
    # Billing date for the invoice list
    string? BillingDocumentListDate?;
    A_BillingDocument_to_Item to_Item?;
    A_BillingDocument_to_Partner to_Partner?;
    A_BillingDocument_to_PricingElement to_PricingElement?;
    A_BillingDocument_to_Text to_Text?;
};

public type A_BillingDocumentText record {
    @constraint:String {maxLength: 10}
    string BillingDocument?;
    @constraint:String {maxLength: 2}
    string Language?;
    @constraint:String {maxLength: 4}
    string LongTextID?;
    string? LongText?;
};

public type CancelWrapperOk record {|
    *http:Ok;
    CancelWrapper body;
|};

public type A_BillingDocumentItem_to_ItemText record {
    A_BillingDocumentItemText[] results?;
};

public type A_BillingDocument_to_PricingElement record {
    A_BillingDocumentPrcgElmnt[] results?;
};
